# ═══════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# ─── Core ──────────────────────────────────────────────────────
# Options: debug (local development) | production (cloud server)
APP_MODE=production
APP_TIMEZONE=Asia/Kolkata
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_SECRET_KEY_HERE
# Dedicated Machine-to-Machine API key (optional, falls back to DJANGO_SECRET_KEY if unset)
M2M_SERVER_KEY=CHANGE_ME_M2M_TOKEN_HERE
# SSL/TLS verification for outbound remote requests (true / false / /path/to/ca-bundle.crt)
SSL_VERIFY=true

# ─── Host / Network ───────────────────────────────────────────
# Server IP: 34.180.29.46
# In debug mode (local): APP_MODE=debug allows all hosts (*)
# In production mode (server): APP_MODE=production enforces server IP & domain security
ALLOWED_HOSTS=34.180.29.46,prvntrde.net.in,localhost
BIND_ADDRESS=0.0.0.0
BIND_PORT=8000
ADMIN_URL_PATH=d4f8g9h2j1m5k8p3

# ═══════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ═══════════════════════════════════════════════════════════════
POSTGRES_DB=algo_trading
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ─── Remote Database (for fetching data if applicable) ────────
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=5432
REMOTE_DB_USER=remote_appuser
REMOTE_DB_PASSWORD=remote_password
REMOTE_DB_NAME=algo_trading

# ═══════════════════════════════════════════════════════════════
# SECURITY TOGGLES
# ═══════════════════════════════════════════════════════════════
DISABLE_CSRF=true
DISABLE_CORS=true
DISABLE_CSP=true
DISABLE_RATE_LIMIT=true

# ═══════════════════════════════════════════════════════════════
# WEBSOCKET BROKER TOGGLES
# ═══════════════════════════════════════════════════════════════
WS_BROKER_A_ENABLED=true
WS_BROKER_B_ENABLED=true
WS_BROKER_C_ENABLED=false

# ═══════════════════════════════════════════════════════════════
# PERFORMANCE TUNING
# ═══════════════════════════════════════════════════════════════
UVICORN_WORKERS=1
UVICORN_BACKLOG=128
DB_CONN_MAX_AGE=600
DB_CONN_POOL_SIZE=5
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════
# Certbot / SSL Configurations (Server Only)
# ═══════════════════════════════════════════════════════════════
DOMAIN_NAME=prvntrde.net.in
ADMIN_EMAIL=your-email@example.com

# ═══════════════════════════════════════════════════════════════
# ALGO ENGINE
# ═══════════════════════════════════════════════════════════════
ALGO_WORKER_COUNT=2
